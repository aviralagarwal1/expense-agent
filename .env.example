# Supabase project URL (Dashboard > Settings > API > Project URL)
SUPABASE_URL=

# Supabase service role key. Server only; never expose to the browser.
# Dashboard > Settings > API
SUPABASE_SERVICE_KEY=

# Public origin of this app, no trailing slash (e.g. https://your-service-xxx.run.app).
# Used for OAuth redirect construction. For local dev, http://127.0.0.1:5000 is fine.
APP_URL=

# Server-managed Anthropic processing. Keep this key server-side only.
# If blank, screenshot processing fails closed and the rest of the app remains available.
# This is the single setting for the per-user UTC daily screenshot allowance.
HOSTED_AI_API_KEY=
HOSTED_DAILY_SCREENSHOT_LIMIT=10

# Optional. Signs the short-lived OAuth (PKCE) cookie. Defaults to the service key;
# set a long random value of your own in production.
AUTH_COOKIE_SECRET=
